    "pg-copy-streams": "^7.0.0",
    "stream-json": "^3.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/pg-copy-streams": "^1.2.5",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
