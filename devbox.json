{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.3/.schema/devbox.schema.json",
  "packages": [
    "nodejs@24",
    "pnpm@11.22.0",
    "postgresql@17",
    "awscli2@latest",
    "jq@latest"
  ],
  "env": {
    "COREPACK_ENABLE_STRICT": "0"
  },
  "env_from": ".env",
  "shell": {
    "init_hook": [
      "test -d node_modules || echo 'run `devbox run setup` to install and build'"
    ],
    "scripts": {
      "setup": [
        "pnpm install --frozen-lockfile",
        "pnpm -r build"
      ],
      "build": "pnpm -r build",
      "test": "pnpm test",
      "lint": "pnpm lint",
      "typecheck": "pnpm typecheck",
      "check": [
        "pnpm lint",
        "pnpm typecheck",
        "pnpm test"
      ],
      "env:setup": "./tools/env-setup.sh",
      "dev": [
        "./tools/env-setup.sh",
        "# .env was read before this script started, so a file env:setup just created is not in the environment yet:",
        "if [ -f .env ]; then set -a; . ./.env; set +a; fi",
        "pnpm --filter @devbox-search/web dev"
      ],
      "migrate": [
        "pnpm --filter '@devbox-search/db...' build",
        "pnpm --filter @devbox-search/db migrate"
      ],
      "index": "node packages/indexer/dist/cli.js \"$@\"",
      "gen-api-docs": "pnpm --filter @devbox-search/web gen:api-docs"
    }
  }
}
