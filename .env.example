# Copy to .env (gitignored) or export in your shell. See docs/self-hosting.md.

# Pooled connection string, read by the API (apps/web). Any Neon endpoint works.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Direct (unpooled) connection string, read by the indexer, seed and migrate.
# COPY and session advisory locks do not work through a transaction-mode
# pooler, so this must not be a pgbouncer/pooler endpoint.
DATABASE_URL_DIRECT=postgresql://user:password@host/db?sslmode=require

# Optional: S3-compatible archive of eval outputs (Cloudflare R2 in production).
# Without these the indexer passes evals between jobs as workflow artifacts only.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=devbox-search-evals
